APP_NAME=E-Commerce API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Local run from terminal: use localhost
# Run inside docker-compose app service: use db
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/ecommerce_api

JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local: redis://localhost:6379 | Docker: redis://redis:6379
REDIS_URL=redis://redis:6379

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me

# Optional seed overrides
SEED_ADMIN_EMAIL=admin@ecommerce.local
SEED_ADMIN_NAME=System Admin
SEED_ADMIN_PASSWORD=Admin12345!
